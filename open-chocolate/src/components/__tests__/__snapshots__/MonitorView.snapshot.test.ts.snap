exports[`MonitorView snapshot > shows the empty state 1`] = `
"<section class="card monitor-card">
  <div class="card-head">
    <h2>MIDI monitor</h2>
    <div class="row gap">
      <div class="seg"><button class="seg-btn active">All</button><button class="seg-btn">RX</button><button class="seg-btn">TX</button></div><label class="row small muted"><input type="checkbox"> auto-scroll </label><button class="btn btn-small">Clear</button>
    </div>
  </div>
  <div class="monitor-list mono">
    <p class="muted empty">No MIDI traffic yet.</p>
  </div>
</section>"
`;

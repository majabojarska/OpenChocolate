    </li>
  </ul>
</section>"
`;

exports[`DevicePanel snapshot > shows the connecting state on the connecting device 1`] = `
"<section class="card">
  <div class="card-head">
    <h2>Devices</h2><span class="muted">1 discovered</span>
  </div>
  <!--v-if-->
  <ul class="device-list">
    <li class="device-row" role="button" tabindex="0" aria-label="Select device Chocolate Plus"><span class="dot dot-yellow dot-pulse" title="Connecting…"></span>
      <div class="device-info"><span class="device-name">Chocolate Plus</span><span class="muted small">SinCo · Connecting…</span></div>
      <!--v-if-->
    </li>
  </ul>
</section>"
`;

exports[`DevicePanel snapshot > shows the disconnect button on the connected device 1`] = `
